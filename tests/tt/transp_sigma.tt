def q : Sigma Nat (\n -> Vec Nat n) := (one , cons Nat zero three (nil Nat))
def vsum : (n : Nat) -> Vec Nat n -> Nat := \n v -> elim Vec Nat (\n _ -> Nat) zero (\n x xs ih -> add x ih) n v
def g (p : Sigma Nat (\n -> Vec Nat n)) : Nat := vsum (fst p) (snd p)
def main : Nat := g (transp (\i -> Sigma Nat (\n -> Vec Nat n)) i0 q)
