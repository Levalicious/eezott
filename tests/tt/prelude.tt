-- eezott test prelude: the data types the tests share.
data Bool : U where
  | true : Bool
  | false : Bool

def not : Bool -> Bool := \b -> elim Bool (\_ -> Bool) false true b
def and : Bool -> Bool -> Bool := \a b -> elim Bool (\_ -> Bool) b false a
def or : Bool -> Bool -> Bool := \a b -> elim Bool (\_ -> Bool) true b a

data Nat : U where
  | zero : Nat
  | suc : Nat -> Nat

def add : Nat -> Nat -> Nat := \m n -> elim Nat (\_ -> Nat) n (\k ih -> suc ih) m
def mul : Nat -> Nat -> Nat := \m n -> elim Nat (\_ -> Nat) zero (\k ih -> add n ih) m
def one : Nat := suc zero
def two : Nat := suc one
def three : Nat := suc two

data Id (A : U) (a : A) : A -> U where
  | refl : Id A a a

data Vec (A : U) : Nat -> U where
  | nil : Vec A zero
  | cons : (n : Nat) -> A -> Vec A n -> Vec A (suc n)

data List (A : U) : U where
  | lnil : List A
  | lcons : A -> List A -> List A

def id : (A : U) -> A -> A := \A x -> x

-- cubical
def prefl (A : U) (x : A) : Path A x x := \i -> x
def sym (A : U) (x y : A) (p : Path A x y) : Path A y x := \i -> p (~ i)
def cong (A B : U) (f : A -> B) (x y : A) (p : Path A x y) : Path B (f x) (f y) := \i -> f (p i)
def funExt (A B : U) (f g : A -> B) (h : (x : A) -> Path B (f x) (g x)) : Path (A -> B) f g := \i -> \x -> h x i
def compPath (A : U) (x y z : A) (p : Path A x y) (q : Path A y z) : Path A x z :=
  \i -> hcomp A (~ i \/ i) (\j -> [ ~ i -> x | i -> q j ]) (p i)
def transport (A B : U) (p : Path U A B) (a : A) : B := transp (\i -> p i) i0 a
def hfill (A : U) (phi : I) (u : (i : I) -> Partial phi A) (u0 : Sub A phi (u i0)) (i : I) : A :=
  hcomp A (phi \/ ~ i) (\j -> [ phi -> u (i /\ j) | ~ i -> outS u0 ]) (outS u0)

-- equivalences and univalence
def isContr (A : U) : U := Sigma A (\x -> (y : A) -> Path A x y)
def fiber (A B : U) (f : A -> B) (y : B) : U := Sigma A (\x -> Path B (f x) y)
def isEquiv (A B : U) (f : A -> B) : U := (y : B) -> isContr (fiber A B f y)
def Equiv (A B : U) : U := Sigma (A -> B) (\f -> isEquiv A B f)
def equivProof (T A : U) (w : Equiv T A) (a : A) (psi : I) (f : Partial psi (fiber T A (fst w) a)) : Sub (fiber T A (fst w) a) psi f :=
  inS (hcomp (fiber T A (fst w) a) (psi \/ ~ psi) (\i -> [ psi -> snd (snd w a) f i | ~ psi -> fst (snd w a) ]) (fst (snd w a)))
def idIsEquiv (A : U) : isEquiv A A (\x -> x) := \y -> ((y , \i -> y) , \q -> \i -> (snd q (~ i) , \j -> snd q (~ i \/ j)))
def idEquiv (A : U) : Equiv A A := (\x -> x , idIsEquiv A)
def ua (A B : U) (e : Equiv A B) : Path U A B := \i -> Glue B (~ i \/ i) [ ~ i -> (A , e) | i -> (B , idEquiv B) ]
-- transport along a line of types is an equivalence (Cubical.Foundations.Equiv.Base, isEquivTransp with phi = i0)
def transpIsEquiv (L : I -> U) : isEquiv (L i0) (L i1) (\x -> transp L i0 x) :=
  transp (\k -> isEquiv (L i0) (L k) (\x -> transp (\j -> L (j /\ k)) (~ k) x)) i0 (idIsEquiv (L i0))
def transpEquiv (L : I -> U) : Equiv (L i0) (L i1) := (\x -> transp L i0 x , transpIsEquiv L)

-- any isomorphism is an equivalence (Cubical.Foundations.Isomorphism, lemIso)
def lemIso (A B : U) (f : A -> B) (g : B -> A) (s : (b : B) -> Path B (f (g b)) b) (t : (a : A) -> Path A (g (f a)) a)
           (y : B) (x0 x1 : A) (p0 : Path B (f x0) y) (p1 : Path B (f x1) y) : Path (fiber A B f y) (x0 , p0) (x1 , p1) :=
  let fill0 : (i : I) -> (k : I) -> A := \i -> hfill A (i \/ ~ i) (\k -> [ i -> t x0 k | ~ i -> g y ]) (inS (g (p0 (~ i)))) in
  let fill1 : (i : I) -> (k : I) -> A := \i -> hfill A (i \/ ~ i) (\k -> [ i -> t x1 k | ~ i -> g y ]) (inS (g (p1 (~ i)))) in
  let fill2 : (i : I) -> (k : I) -> A := \i -> hfill A (i \/ ~ i) (\k -> [ i -> fill1 k i1 | ~ i -> fill0 k i1 ]) (inS (g y)) in
  let p : Path A x0 x1 := \i -> fill2 i i1 in
  let sq : (i : I) -> (j : I) -> A := \i j -> hcomp A (i \/ ~ i \/ j \/ ~ j)
        (\k -> [ i -> fill1 j (~ k) | ~ i -> fill0 j (~ k) | j -> t (fill2 i i1) (~ k) | ~ j -> g y ]) (fill2 i j) in
  let sq1 : (i : I) -> (j : I) -> B := \i j -> hcomp B (i \/ ~ i \/ j \/ ~ j)
        (\k -> [ i -> s (p1 (~ j)) k | ~ i -> s (p0 (~ j)) k | j -> s (f (p i)) k | ~ j -> s y k ]) (f (sq i j)) in
  \i -> (p i , \j -> sq1 i (~ j))
def isoToIsEquiv (A B : U) (f : A -> B) (g : B -> A) (s : (b : B) -> Path B (f (g b)) b) (t : (a : A) -> Path A (g (f a)) a) : isEquiv A B f :=
  \y -> ((g y , s y) , \z -> lemIso A B f g s t y (g y) (fst z) (s y) (snd z))
def isoToEquiv (A B : U) (f : A -> B) (g : B -> A) (s : (b : B) -> Path B (f (g b)) b) (t : (a : A) -> Path A (g (f a)) a) : Equiv A B :=
  (f , isoToIsEquiv A B f g s t)
