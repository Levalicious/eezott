#import bignat
-- the multiplication layer at closed instances: the kernel's bignum computes both sides, refl checks them.
-- The evaluator memoizes (Design_Eezott_EvalMemoization_2026_09_14: the unfold of a rigid definition application,
-- closure applications and elim reductions, keyed on the value and tagged with the metas generation), so the closed
-- instances below are cheap: t8's 3x2 row would have needed more than the harness's whole budget before that pass.
-- What still bounds the shapes is the BUDGET, not the engine - it counts allocations, not live bytes, so a 3-limb
-- nested badd or a 3x3 product runs outside the suite (records: 7.8s and 21s) but not under the cap. t7 is the
-- Finding_Eezott_EvalNoSharing_2026_09_14 repro: nesting badd over computed operands used to OOM here.
def t1 : Path Nat (bval (bmul (lcons 1 (lnil {Nat})) (lcons 1 (lnil {Nat})))) 1 := prefl Nat 1
def t2 : Path Nat (bval (bmul (lcons 2 (lcons 3 (lnil {Nat}))) (lcons 4 (lnil {Nat})))) 147573952589676412940 := prefl Nat 147573952589676412940
def t3 : Path Nat (bval (bmul (lcons 18446744073709551615 (lcons 18446744073709551615 (lnil {Nat}))) (lcons 18446744073709551615 (lcons 18446744073709551615 (lnil {Nat}))))) 115792089237316195423570985008687907852589419931798687112530834793049593217025 := prefl Nat 115792089237316195423570985008687907852589419931798687112530834793049593217025
-- the correctness theorems at symbolic operands
def t4 (x y : BigNat) : Path Nat (bval (bmul x y)) (mul (bval x) (bval y)) := bmul_ok x y
def t5 (x y : BigNat) : Path Nat (bval (badd x y)) (add (bval x) (bval y)) := badd_ok x y
-- a theorem instance at closed operands: the proof itself computes down to refl
def t6 : Path Nat (bval (bmul (lcons 3 (lnil {Nat})) (lcons 4 (lnil {Nat})))) 12 := bmul_ok (lcons 3 (lnil {Nat})) (lcons 4 (lnil {Nat}))
def t7 : Path Nat (bval (badd (badd (lcons 1 (lcons 2 (lnil {Nat}))) (lcons 6 (lcons 7 (lnil {Nat})))) (badd (lcons 1 (lcons 2 (lnil {Nat}))) (lcons 6 (lcons 7 (lnil {Nat})))))) 258254417031933722642 := prefl Nat 258254417031933722642
def t8 : Path Nat (bval (bmul (lcons 1 (lcons 2 (lcons 3 (lnil {Nat})))) (lcons 4 (lcons 5 (lnil {Nat}))))) 25108406941546723059766828462802865689839120044090734936079 := prefl Nat 25108406941546723059766828462802865689839120044090734936079
def main : Nat := bval (bmul (lcons 6 (lnil {Nat})) (lcons 7 (lnil {Nat})))
