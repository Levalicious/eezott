#import prelude
-- M16b: pow is where a number stops being holdable. Its size is known before the work starts - the base's
-- bits times the exponent - so 3 ^ (2 ^ 64), which needs 2 ^ 65 bits, is refused by name instead of being
-- allocated towards. main is a power that does fit, and it computes
def huge : Nat := pow 3 18446744073709551616
def main : Nat := pow 3 40
