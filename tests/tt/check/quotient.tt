-- the set quotient: a point constructor, a path constructor with non-recursive arguments, and the 2-dimensional
-- squash constructor with recursive path arguments; the identity elimination exercises PathP and Sub methods
data SQ (A : U) (R : A -> A -> U) : U where
  | inc : A -> SQ A R
  | eq : (a : A) -> (b : A) -> R a b -> (i : I) -> SQ A R [ ~ i -> inc a | i -> inc b ]
  | squash : (x : SQ A R) -> (y : SQ A R) -> (p : Path (SQ A R) x y) -> (q : Path (SQ A R) x y) -> (i : I) -> (j : I) -> SQ A R [ ~ i -> p j | i -> q j | ~ j -> x | j -> y ]
def idSQ (A : U) (R : A -> A -> U) : SQ A R -> SQ A R :=
  \s -> elim SQ (\_ -> SQ A R) (\a -> inc a) (\a b r -> \i -> eq a b r i) (\x y p q ihx ihy ihp ihq -> \i j -> inS (squash ihx ihy ihp ihq i j)) s
-- the suspension: two points and a meridian for every element of the parameter
data Susp (A : U) : U where
  | N : Susp A
  | S : Susp A
  | merid : A -> (i : I) -> Susp A [ ~ i -> N | i -> S ]
def idSusp (A : U) : Susp A -> Susp A := \s -> elim Susp (\_ -> Susp A) (N) (S) (\a -> \i -> merid a i) s
-- propositional truncation into itself
data PT (A : U) : U where
  | tinc : A -> PT A
  | sq : (x : PT A) -> (y : PT A) -> (i : I) -> PT A [ ~ i -> x | i -> y ]
def idPT (A : U) : PT A -> PT A := \t -> elim PT (\_ -> PT A) (\a -> tinc a) (\x y ihx ihy -> \i -> sq ihx ihy i) t
def main : Nat := one
