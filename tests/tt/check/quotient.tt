-- the set quotient and the propositional truncation (declared in the prelude): the identity eliminations exercise PathP and
-- Sub methods; the suspension: two points and a meridian for every element of the parameter
def idSQ (A : U) (R : A -> A -> U) : SQ A R -> SQ A R :=
  \s -> elim SQ (\_ -> SQ A R) (\a -> inc a) (\a b r -> \i -> eq a b r i) (\x y p q ihx ihy ihp ihq -> \i j -> inS (squash ihx ihy ihp ihq i j)) s
data Susp (A : U) : U where
  | N : Susp A
  | S : Susp A
  | merid : A -> (i : I) -> Susp A [ ~ i -> N | i -> S ]
def idSusp (A : U) : Susp A -> Susp A := \s -> elim Susp (\_ -> Susp A) (N) (S) (\a -> \i -> merid a i) s
def idPT (A : U) : PT A -> PT A := \t -> elim PT (\_ -> PT A) (\a -> tinc a) (\x y ihx ihy -> \i -> squash1 ihx ihy i) t
def main : Nat := one
