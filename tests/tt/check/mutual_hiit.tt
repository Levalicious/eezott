-- the induction principle of a block with a path constructor is formed at the declaration; transport along a constant
-- line of R and a composition in R are well-typed, and the path constructor's boundary reduces
mutual
  data R : U where
    | rat : Nat -> R
    | lim : (x : Nat -> R) -> ((d e : Nat) -> Close (add d e) (x d) (x e)) -> R
    | eqR : (u v : R) -> ((e : Nat) -> Close e u v) -> (i : I) -> R [ ~ i -> u | i -> v ]
  data Close : Nat -> R -> R -> U where
    | crat : (e q r : Nat) -> Close e (rat q) (rat r)
    | clim : (e : Nat) -> (x : Nat -> R) -> (p : (d e' : Nat) -> Close (add d e') (x d) (x e')) -> (q : Nat) -> Close e (lim x p) (rat q)
end
def p : Path R (rat one) (rat two) := \i -> eqR (rat one) (rat two) (\e -> crat e one two) i
def q : Path R (rat one) (rat two) := \i -> transp (\_ -> R) i0 (p i)
def h : R := hcomp R i0 (\_ -> []) (rat one)
def viaClose : Close zero (rat one) (rat one) := crat zero one one
def main : Nat := one
