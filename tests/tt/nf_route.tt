-- a recipe as an indexed higher inductive value: the coherence cell at its endpoint is the route it identifies
data Route (V : U) (E : V -> V -> U) : V -> V -> U where
  | stop : (a : V) -> Route V E a a
  | step : (a : V) -> (b : V) -> (c : V) -> E a b -> Route V E b c -> Route V E a c
  | commute : (a : V) -> (b : V) -> (r : Route V E a b) -> (s : Route V E a b) -> (i : I) -> Route V E a b [ ~ i -> r | i -> s ]
def Edge (a : Bool) (b : Bool) : U := Nat
def r : Route Bool Edge true false := step true false false one (stop false)
def s : Route Bool Edge true false := step true true false zero (step true false false two (stop false))
def main : Route Bool Edge true false := commute true false r s i1
