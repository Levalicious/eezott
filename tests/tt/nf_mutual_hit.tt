-- a path constructor in a mutual block (the shape of the Cauchy reals, HoTT 11.3): eqR identifies elements that are close at
-- every scale; at an endpoint it reduces through its boundary, in the checker and at run time
mutual
  data R : U where
    | rat : Nat -> R
    | lim : (x : Nat -> R) -> ((d e : Nat) -> Close (add d e) (x d) (x e)) -> R
    | eqR : (u v : R) -> ((e : Nat) -> Close e u v) -> (i : I) -> R [ ~ i -> u | i -> v ]
  data Close : Nat -> R -> R -> U where
    | crat : (e q r : Nat) -> Close e (rat q) (rat r)
    | clim : (e : Nat) -> (x : Nat -> R) -> (p : (d e' : Nat) -> Close (add d e') (x d) (x e')) -> (q : Nat) -> Close e (lim x p) (rat q)
end
def main : R := eqR (rat one) (rat two) (\e -> crat e one two) i1
