-- a list type with an explicit level parameter, holding types: its length computes at run time (the level erases)
data List2 (l : Level) (A : U {l}) : U {l} where
  | nil2 : List2 l A
  | cons2 : A -> List2 l A -> List2 l A
def len (l : Level) (A : U {l}) (xs : List2 l A) : Nat := elim List2 (\_ -> Nat) zero (\x xs ih -> suc ih) xs
def main : Nat := len 1 U (cons2 Nat (cons2 Bool (nil2)))
