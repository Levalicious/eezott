data QVec (A : U) : Nat -> U where
  | qnil : QVec A zero
  | qcons : (n : Nat) -> A -> QVec A n -> QVec A (suc n)
  | swap : (n : Nat) -> (x : A) -> (y : A) -> (v : QVec A n) -> (i : I) -> QVec A (suc (suc n))
      [ ~ i -> qcons (suc n) x (qcons n y v) | i -> qcons (suc n) y (qcons n x v) ]
-- the WRONG method: its boundary is qcons (suc n) x (qcons n y ih), not the constructor's; must be rejected
def idQ : (n : Nat) -> QVec Bool n -> QVec Bool n := \n w -> elim QVec (\n _ -> QVec Bool n) qnil (\n x v ih -> qcons n x v) (\n x y v ih -> \i -> swap n x y ih i) n w
